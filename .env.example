# The Connector talks to the same backend as Software.
# Android emulator: http://10.0.2.2:3000
# Physical device: use your computer's LAN address, e.g. http://192.168.1.10:3000
EXPO_PUBLIC_APPLICATION_MODE=development
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
EXPO_PUBLIC_AUTH_BASE_PATH=/api/auth
EXPO_PUBLIC_API_PREFIX=/api/v1
EXPO_PUBLIC_GRAPHQL_PATH=/graphql

# Browser/mobile-visible Ola Maps key. Do not place server secrets in Expo public variables.
EXPO_PUBLIC_OLA_MAPS_API_KEY=
