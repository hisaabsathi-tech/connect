{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "src/**/*",
      "scripts/**/*",
      "test/**/*",
      "app.config.ts",
      "*.config.js",
      "*.json",
      "nativewind-env.d.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "react-native": {
                "importNames": ["Text"],
                "message": "Use Text from @/components/modules/typography so copy is set in Satoshi."
              }
            }
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/components/ui/**", "src/components/modules/typography/**"],
      "linter": { "rules": { "style": { "noRestrictedImports": "off" } } }
    }
  ]
}
